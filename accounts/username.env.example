# One file per Nextcloud account. Copy this to <name>.env in your ACCOUNTS_DIR
# (e.g. accounts/alice.env) and fill it in. Only files ending in .env are
# loaded; <name> is used for that account's cache files.
NC_URL=https://cloud.example.com/remote.php/dav/files/username/
NC_USER=username
NC_PASS=app-token-for-username

# Optional: override the global .env for this account only
# NC_SECRET=
# NC_STRICT_TLS=true
