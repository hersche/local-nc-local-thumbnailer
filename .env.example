NC_URL=https://nc-local-test.project.test/remote.php/dav/files/admin/
NC_USER=admin
NC_PASS=MySecretPassword123!
NC_SECRET=
NC_STRICT_TLS=false

# --- Multi-account mode (optional) ---
# Directory containing one <name>.env per Nextcloud account.
# Each file must set NC_URL, NC_USER and NC_PASS (NC_SECRET / NC_STRICT_TLS
# fall back to the values above). Accounts are processed one after another,
# each with its own cache files in CACHE_DIR. When ACCOUNTS_DIR is set, the
# single-account NC_* values above are ignored.
# ACCOUNTS_DIR=./accounts
# CACHE_DIR=./cache

# Days to skip rescanning an unchanged folder
SCAN_INTERVAL_DAYS=7

# Local paths (single-account mode)
TEMP_DIR=./tmp_thumbs
FOLDER_CACHE=./folder_cache.json
THUMB_CACHE=./thumb_cache.csv
FAIL_CACHE=./fail_cache.csv

# Performance
FFMPEG_THREADS=
IO_CONCURRENCY=2
MAX_VIDEO_SIZE_MB=3000
